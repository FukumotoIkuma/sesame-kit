{
  "name": "sesame-kit-workspace",
  "version": "0.6.2",
  "private": true,
  "description": "Monorepo for sesame-kit: @sesame-kit/core (library) + sesame-kit (CLI/serve/SDK). Control your SESAME smart lock from your own code — even directly over Bluetooth, offline. Unofficial.",
  "author": "Ikuma Fukumoto",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/kit"
  ],
  "homepage": "https://github.com/FukumotoIkuma/sesame-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FukumotoIkuma/sesame-kit.git"
  },
  "bugs": {
    "url": "https://github.com/FukumotoIkuma/sesame-kit/issues"
  },
  "scripts": {
    "cli": "node packages/kit/bin/sesame.js",
    "test": "vitest run --project unit && vitest run --project e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/kit/tsconfig.json --noEmit",
    "lint": "biome lint",
    "build:types": "tsc -b packages/core packages/kit && node scripts/strip-private-decls.mjs",
    "build:rpc-schema": "node scripts/gen-rpc-schema.mjs",
    "build:grpc-proto": "node scripts/gen-grpc-proto.mjs",
    "build:openrpc": "node scripts/gen-openrpc.mjs",
    "build:sdk:ts": "node scripts/gen-sdk-ts.mjs",
    "build:sdk:py": "node scripts/gen-sdk-py.mjs",
    "build:sdk": "node scripts/gen-sdk-ts.mjs && node scripts/gen-sdk-py.mjs",
    "typecheck:sdk": "tsc -p packages/kit/sdk/ts/tsconfig.json",
    "check:sdk:py": "python3 -B -m py_compile packages/kit/sdk/python/sesame_client.py",
    "check:refs": "node scripts/check-refs.mjs",
    "build": "npm run build:types && node scripts/gen-rpc-schema.mjs && node scripts/gen-grpc-proto.mjs && node scripts/gen-openrpc.mjs && node scripts/gen-sdk-ts.mjs && node scripts/gen-sdk-py.mjs",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "ink": "^7.0.6",
    "ink-select-input": "^6.2.0",
    "ink-testing-library": "^4.0.0",
    "ink-text-input": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@mapbox/node-pre-gyp": "^2.0.3",
    "cacache": "^20.0.1",
    "make-fetch-happen": "^15.0.6",
    "node-gyp": "^12.4.0",
    "tar": "^7.5.16"
  },
  "engines": {
    "node": ">=20"
  }
}
