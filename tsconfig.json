{
  "//": "JSDoc から .d.ts を生成しつつ src/ を厳格に型チェックする (実行時は素の JS)。`npm run build:types` で types/ に出力 + 型検証。checkJs+strict を有効化済み。",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "types",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "tests", "types"]
}
