node_modules/
# 旧構成 (プロジェクトルート保存) の残骸; 0.2 以降は ~/.config/sesame-kit/ に保存
.env
.env.local
.secrets.json
.tokens.json
.login_state.json
.cache/
*.log
scratch/
# ユーザ固有の IR キーマッピング (migrate 用の個人 artifact)
keys.json
# 開発中の一時テストスクリプト (_*.mjs パターンで pollute されがち)
_*.mjs

# 広報素材 (投稿用ドラフト・GIF 録画スクリプト。リポジトリ/npm には含めない)
promo/
# README 用の生成 GIF は assets/demo.{en,ja}.gif を追跡する (gen-gifs.sh が出力)。

# 参照実装 (一次ソース・コミットしない)。配置場所と中身は REFERENCES.md を参照。
#   _sesame_sdk_ref/ : Android SesameSDK (Kotlin。CHHub3Device.kt 等の引用元)
#   references_web/   : biz3 web (CANDY-HOUSE/biz3。src/api/useManageDevice.js 等の引用元)
/_sesame_sdk_ref/
/references_web/

# Python client build artifacts
clients/python/build/
clients/python/*.egg-info/
__pycache__/
*.pyc
